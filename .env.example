# 服务器配置（支持多个，用数字后缀区分）
# 格式: VITE_SERVER_{N}_TYPE / _URL / _USERNAME / _PASSWORD / _LIBRARY(可选)

# 服务器 1
VITE_SERVER_1_TYPE=audiobookshelf
VITE_SERVER_1_URL=https://your-abs-server.com
VITE_SERVER_1_USERNAME=
VITE_SERVER_1_PASSWORD=

# 服务器 2
VITE_SERVER_2_TYPE=emby
VITE_SERVER_2_URL=https://your-emby-server.com:8443
VITE_SERVER_2_USERNAME=
VITE_SERVER_2_PASSWORD=

# 可选: 指定默认库名（留空则登录后选择）
# VITE_SERVER_1_LIBRARY=有声书
